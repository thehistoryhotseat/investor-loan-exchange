{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thehistoryhotseat.github.io/investor-loan-exchange/scenario.schema.json",
  "title": "Investor Loan Exchange scenario",
  "description": "One loan scenario as submitted to the Investor Loan Exchange intake. Scenarios only, never personal documents. All money figures in USD. This is the lender-facing record: the submitter's contact details are collected separately and withheld until they choose to engage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "purpose",
    "property",
    "loan_amount_usd",
    "credit_band",
    "citizenship"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.7"
    },
    "prepared_by": {
      "type": "string",
      "description": "Name of the person or agent that prepared this file, e.g. your-agent. Never the borrower's name."
    },
    "product": {
      "type": "string",
      "enum": [
        "dscr_rental",
        "fix_flip",
        "bridge",
        "ground_up_construction",
        "cash_out_refi",
        "conforming_agency",
        "home_equity"
      ]
    },
    "purpose": {
      "type": "string",
      "enum": [
        "purchase",
        "refinance",
        "rate_term_refi",
        "cash_out"
      ]
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "occupancy",
        "state",
        "est_value_usd"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "Property type slug. One of the enum values.",
          "enum": [
            "single_family",
            "2_4_unit",
            "condo",
            "townhome",
            "small_multifamily_5",
            "mixed_use",
            "other"
          ]
        },
        "occupancy": {
          "type": "string",
          "enum": [
            "investment",
            "owner_occupied"
          ],
          "description": "\"investment\" on every lane except home_equity, which also accepts \"owner_occupied\" (primary home)."
        },
        "state": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "zip": {
          "type": "string"
        },
        "est_value_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "units": {
          "type": "integer",
          "minimum": 1
        },
        "condition": {
          "type": "string",
          "enum": [
            "turnkey",
            "light_rehab",
            "heavy_rehab",
            "shell"
          ],
          "description": "snake_case. credit_band is the exception: it keeps its display form (780+, 740-779, 700-739, 660-699, 620-659, below_620)"
        }
      }
    },
    "loan_amount_usd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "ltv": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1.5,
      "description": "loan_amount_usd / est_value_usd"
    },
    "role": {
      "type": "string",
      "enum": [
        "broker",
        "borrower"
      ]
    },
    "credit_band": {
      "type": "string",
      "enum": [
        "780+",
        "740-779",
        "700-739",
        "660-699",
        "620-659",
        "below_620"
      ]
    },
    "citizenship": {
      "type": "string",
      "enum": [
        "us_person",
        "foreign_national"
      ],
      "description": "Foreign nationals price differently on most panels"
    },
    "experience": {
      "type": "string"
    },
    "liquidity_band": {
      "type": "string",
      "enum": [
        "3_months",
        "6_months",
        "12_plus_months"
      ]
    },
    "vesting": {
      "type": "string",
      "enum": [
        "llc",
        "personal_name",
        "trust",
        "other_entity"
      ]
    },
    "target_close": {
      "type": "string",
      "format": "date"
    },
    "monthly_rent_usd": {
      "type": "number",
      "minimum": 0
    },
    "monthly_taxes_usd": {
      "type": "number",
      "minimum": 0
    },
    "monthly_insurance_usd": {
      "type": "number",
      "minimum": 0
    },
    "monthly_hoa_usd": {
      "type": "number",
      "minimum": 0
    },
    "estimated_dscr": {
      "type": "number",
      "description": "Illustrative estimate, not a lender figure"
    },
    "arv_usd": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "After-repair value, fix & flip"
    },
    "rehab_budget_usd": {
      "type": "number",
      "minimum": 0
    },
    "exit_strategy": {
      "type": "string",
      "enum": [
        "sell",
        "refinance_into_dscr",
        "undecided"
      ]
    },
    "flip_experience": {
      "type": "string"
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "structure": {
          "type": "string",
          "enum": [
            "amortizing",
            "interest_only",
            "either"
          ]
        },
        "rate_type": {
          "type": "string"
        },
        "prepay_tolerance": {
          "type": "string",
          "enum": [
            "none",
            "up_to_6mo",
            "up_to_12mo",
            "up_to_3yr",
            "up_to_5yr",
            "flexible"
          ]
        }
      }
    },
    "conforming": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "under_county_limit": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "not_sure"
          ]
        },
        "dti_band": {
          "type": "string",
          "enum": [
            "under_36",
            "36_43",
            "43_50",
            "over_50",
            "not_sure"
          ],
          "description": "Conforming (agency): debt-to-income band. Agency investment loans price on DTI."
        },
        "note": {
          "type": "string",
          "description": "Free-text note for lenders on a conforming deal."
        }
      },
      "required": [
        "under_county_limit"
      ]
    },
    "notes": {
      "type": "string",
      "description": "Free text for lenders. Never names, SSNs, dates of birth, account numbers, or documents."
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "share_with_lenders",
        "contact_withheld_until_engaged"
      ],
      "properties": {
        "share_with_lenders": {
          "type": "boolean",
          "const": true,
          "description": "Checked personally by the human submitter; an agent must never set this on a person's behalf"
        },
        "contact_withheld_until_engaged": {
          "type": "boolean",
          "const": true
        }
      },
      "description": "Added by the human submitter in the intake form. An agent preparing this file leaves consent out entirely; it is never the agent's to give."
    },
    "loan_to_cost": {
      "type": "number",
      "description": "Computed by the intake for fix & flip: loan / (purchase price + rehab). Illustrative."
    },
    "loan_to_arv": {
      "type": "number",
      "description": "Computed by the intake for fix & flip: loan / after-repair value. Illustrative."
    },
    "bridge_exit_strategy": {
      "type": "string",
      "enum": [
        "sell",
        "refinance_into_dscr",
        "refinance_into_conventional",
        "undecided"
      ],
      "description": "Bridge deals: how the loan gets taken out"
    },
    "bridge_term": {
      "type": "string",
      "enum": [
        "up_to_6_months",
        "6_12_months",
        "12_24_months"
      ],
      "description": "Bridge deals: term needed"
    },
    "project_budget_usd": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Ground-up construction: total project budget"
    },
    "build_timeline": {
      "type": "string",
      "enum": [
        "under_9_months",
        "9_12_months",
        "12_18_months",
        "over_18_months"
      ],
      "description": "Ground-up construction: expected build timeline"
    },
    "land_status": {
      "type": "string",
      "enum": [
        "owned",
        "under_contract",
        "not_yet"
      ],
      "description": "Ground-up construction: land status"
    },
    "guc_exit_strategy": {
      "type": "string",
      "enum": [
        "sell",
        "refinance_into_dscr",
        "undecided"
      ],
      "description": "Ground-up construction: how the loan gets taken out"
    },
    "home_equity_type": {
      "type": "string",
      "enum": [
        "heloc",
        "home_equity_loan"
      ],
      "description": "Home equity lane: HELOC (line of credit) or home equity loan (lump sum). Primary or investment property."
    },
    "first_mortgage_balance_usd": {
      "type": "number",
      "minimum": 0,
      "description": "Home equity lane: current balance of the first mortgage. Second liens price on combined LTV (CLTV = (first balance + new loan) / value)."
    },
    "cltv": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 2,
      "description": "Home equity lane: combined LTV, (first_mortgage_balance_usd + loan_amount_usd) / est_value_usd."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "product": {
            "const": "dscr_rental"
          }
        },
        "required": [
          "product"
        ]
      },
      "then": {
        "required": [
          "monthly_rent_usd"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "product": {
            "const": "fix_flip"
          }
        },
        "required": [
          "product"
        ]
      },
      "then": {
        "required": [
          "arv_usd",
          "rehab_budget_usd"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "product": {
            "const": "conforming_agency"
          }
        },
        "required": [
          "product"
        ]
      },
      "then": {
        "required": [
          "conforming"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "product": {
            "const": "bridge"
          }
        },
        "required": [
          "product"
        ]
      },
      "then": {
        "required": [
          "bridge_exit_strategy",
          "bridge_term"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "product": {
            "const": "ground_up_construction"
          }
        },
        "required": [
          "product"
        ]
      },
      "then": {
        "required": [
          "project_budget_usd",
          "build_timeline",
          "guc_exit_strategy"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "product": {
            "not": {
              "const": "home_equity"
            }
          }
        },
        "required": [
          "product"
        ]
      },
      "then": {
        "properties": {
          "property": {
            "properties": {
              "occupancy": {
                "const": "investment"
              }
            }
          }
        },
        "not": {
          "required": [
            "home_equity_type"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "product": {
            "const": "home_equity"
          }
        },
        "required": [
          "product"
        ]
      },
      "then": {
        "required": [
          "home_equity_type"
        ]
      }
    }
  ]
}